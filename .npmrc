# Supply-chain hardening: prefer packages at least 7 days old to avoid
# zero-day trojaned releases of popular packages — by the time we'd see
# one, the real maintainer has usually noticed and yanked it.
#
# Requires pnpm 10.16+. NOTE: pnpm interprets this value in MINUTES
# (unlike bun's minimumReleaseAge which is seconds). 7d × 24h × 60min
# = 10080.
minimum-release-age=10080

# Don't ABORT when the latest release is younger than the gate — fall
# back to the most recent mature version instead. Without this, pnpm
# defaults to strict mode (because we set minimum-release-age
# explicitly) and `pnpm update --latest` fails the entire run any time
# a single dep has shipped within the window. Strict-false picks the
# newest version that DOES meet the constraint, which is what we want
# for the weekly auto-update sweep.
minimum-release-age-strict=false
