# Dependencies (recursive — the monorepo has node_modules in every workspace)
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# Build outputs (recursive: apps/*/dist, apps/frontend/.next, .turbo, etc.)
**/.next
**/dist
**/build
**/.turbo
out

# Environment files (provided at runtime, never baked into the image)
.env
.env.*

# Git / VCS / CI
.git
.gitignore
.gitattributes
.gitea
.github

# Docker + dev tooling (not needed in the build context; entrypoints live in
# docker/ and ARE included because the Dockerfiles COPY them)
docker/docker-compose*.yml
.dockerignore
.devcontainer
.claude

# Editors / OS
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs / runtime data
logs
*.log
pids
*.pid
*.seed
*.pid.lock

# Coverage / temp
**/coverage
tmp
temp

# Tests (the production build never runs them)
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# Docs and large repository assets (not needed in the image)
docs
*.md
metamcp.svg
metamcp_screenshot.png
