{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Bare minimum Express 5.1 backend with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target bun --outdir dist --sourcemap=linked",
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:generate:dev": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:migrate:dev": "dotenv -e ../../.env.local -- drizzle-kit migrate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@repo/trpc": "workspace:*",
    "@repo/zod-types": "workspace:*",
    "@trpc/server": "^11.19.0",
    "better-auth": "1.7.6",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "shell-quote": "^1.10.0",
    "spawn-rx": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
