{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Bare minimum Express 5.1 backend with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target bun --outdir dist --sourcemap=linked",
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:generate:dev": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:migrate:dev": "dotenv -e ../../.env.local -- drizzle-kit migrate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@repo/trpc": "workspace:*",
    "@repo/zod-types": "workspace:*",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.6.23",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "nanoid": "^5.1.16",
    "pg": "^8.22.0",
    "shell-quote": "^1.9.0",
    "spawn-rx": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
