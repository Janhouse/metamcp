# Development Dockerfile with hot reload support
# Bun 1.4 (Rust build) is the dev runtime; Node + uv remain for spawning
# MCP servers as child processes during development.
FROM oven/bun:1.4 AS base

# Node.js (node/npx MCP servers), Docker CLI (container management), Tini (signals),
# bubblewrap + util-linux (MCP sandbox: MCP_SANDBOX=bwrap and MCP_LIMIT_* via prlimit).
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs docker.io tini bubblewrap util-linux \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# uv / uvx (Python-based MCP servers).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Development stage
FROM base AS dev
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Copy package files for dependency installation
COPY package.json bun.lock bunfig.toml turbo.json ./

# Copy package.json files from all workspaces (needed for dependency installation)
COPY apps/frontend/package.json ./apps/frontend/
COPY apps/backend/package.json ./apps/backend/
COPY packages/trpc/package.json ./packages/trpc/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/zod-types/package.json ./packages/zod-types/

# Install all dependencies (including dev dependencies)
RUN bun install

# Copy source code directories (overridden by volume mounts, but ensures structure exists)
COPY apps ./apps
COPY packages ./packages

# Expose ports
EXPOSE 12008 12009

# Health check for development
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:12008/health || exit 1

# Copy entrypoint script
COPY docker/docker-entrypoint-dev.sh ./docker-entrypoint-dev.sh
RUN chmod +x docker-entrypoint-dev.sh && \
    ls -la docker-entrypoint-dev.sh

# Use Tini as the init process to handle signals and zombie processes properly
ENTRYPOINT ["/usr/bin/tini", "--"]

# Use the development entrypoint script
CMD ["./docker-entrypoint-dev.sh"]
