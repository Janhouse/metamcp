{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // bun workspaces (apps/*, packages/*) are auto-detected from package.json.
  // apps/*/components/ui/** is vendored shadcn/ui: treat as entry surface so its
  // full API is not flagged unused while its imports still count as used deps.
  "entry": ["apps/*/components/ui/**"],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
